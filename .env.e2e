# Environment for the Playwright E2E suite ONLY (specs/features/e2e-testing.md).
#
# This file is committed on purpose: it contains no secrets, only throwaway
# credentials for a local SQLite file and the local MinIO bucket that stands in
# for S3. Every value here is disposable — `npm run e2e:reset` drops and rebuilds
# the database, and the APP_KEY below encrypts nothing but test fixtures.
#
# NEVER copy this file to .env, and never point it at a real bucket or database.

APP_NAME="ORCA DAM E2E"
APP_ENV=e2e
APP_KEY=base64:ZTJlLW9ubHktbm90LWEtc2VjcmV0LWtleS0xMjM0NTY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8100

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# A file DB, not :memory: — `artisan serve` is a separate process per request.
DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

# File sessions, NOT database: a mid-run reseed truncates `sessions` and would
# invalidate every saved storageState (e2e-testing.md REQ-5).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Array cache: settings changes take effect on the next request and throttle
# counters never leak between tests (REQ-5).
CACHE_STORE=array
BROADCAST_CONNECTION=log

# Sync queue: thumbnail/resize jobs finish before the HTTP response (REQ-6).
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="e2e@orca.test"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (docker-compose.e2e.yml) standing in for S3.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=orca-e2e
AWS_SECRET_ACCESS_KEY=orca-e2e-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=orca-e2e
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://127.0.0.1:9000/orca-e2e

# No outbound AWS/Cloudflare calls from a test run.
AWS_REKOGNITION_ENABLED=false
CLOUDFLARE_ENABLED=false
JWT_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
